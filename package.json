{
  "name": "@rilevera/tree-sitter-python",
  "version": "1.0.1",
  "packageManager": "bun@1.3.11",
  "description": "Python grammar for tree-sitter, distributed as WebAssembly",
  "license": "MIT",
  "author": {
    "name": "Max Brunsfeld",
    "email": "maxbrunsfeld@gmail.com"
  },
  "contributors": [
    {
      "name": "Amaan Qureshi",
      "email": "amaanq12@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rilevera/tree-sitter-python.git"
  },
  "main": "./tree-sitter-python.wasm",
  "types": "./tree-sitter-python.wasm.d.ts",
  "exports": {
    ".": {
      "types": "./tree-sitter-python.wasm.d.ts",
      "default": "./tree-sitter-python.wasm"
    },
    "./tree-sitter-python.wasm": {
      "types": "./tree-sitter-python.wasm.d.ts",
      "default": "./tree-sitter-python.wasm"
    }
  },
  "files": [
    "tree-sitter-python.wasm",
    "tree-sitter-python.wasm.d.ts",
    "LICENSE"
  ],
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "python",
    "webassembly",
    "wasm"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "bun": ">=1.3.6 <1.3.12"
  },
  "scripts": {
    "check:bun": "bun run scripts/check-bun-version.ts",
    "build": "make parser-build",
    "test": "make test"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.11"
  }
}
